# --- LLM via the Bifrost AI gateway (see README "LLM gateway (Bifrost)") -----------------
# From anywhere (laptop, GitHub Actions):  https://<gateway host>/v1
# OCI instance in the same VCN:            http://<gateway private IP>:8080/v1
BIFROST_BASE_URL=https://<gateway host>/v1
# This project's virtual key, created in the Bifrost dashboard.
BIFROST_API_KEY=sk-bf-...
# Bifrost model names are provider/model: openai/..., anthropic/..., gemini/...
# MODEL=openai/gpt-4.1-mini

# --- LLM without the gateway (leave BIFROST_BASE_URL empty) ------------------------------
# CrewAI then calls the provider directly; OpenAI by default.
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4.1-mini

# --- Daily email (see README "Daily email") ----------------------------------------------
# Any SMTP server: a transactional email service in production (Brevo, Amazon SES, Resend,
# OCI Email Delivery...), with your domain's SPF/DKIM set up there.
SMTP_HOST=
# SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none (local test server only)
# SMTP_SECURITY=starttls
MAIL_FROM="Resumo de Ações <resumo@yourdomain.com>"
# Public address of the sign-up page: links in the emails start with it.
PUBLIC_URL=https://<your host>
# Shown on the privacy page.
CONTACT_EMAIL=

# --- Optional ----------------------------------------------------------------------------
# SQLite file: digests, subscribers, deliveries and the saved ratings.
# DATABASE_FILE=reporter.db
# The stocks to report on, one ticker per line.
# WATCHLIST_FILE=watchlist.txt
# REPORTS_DIR=reports
# HTTP_TIMEOUT_SECONDS=15
# Where CVM downloads are cached (refreshed daily).
# CACHE_DIR=~/.cache/crewai_invest_reporter
