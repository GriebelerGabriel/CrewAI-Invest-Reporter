# --- LLM via the Bifrost AI gateway (see README "LLM gateway (Bifrost)") -----------------
# From anywhere (laptop, GitHub Actions):  https://<gateway host>/v1
# OCI instance in the same VCN:            http://<gateway private IP>:8080/v1
BIFROST_BASE_URL=https://<gateway host>/v1
# This project's virtual key, created in the Bifrost dashboard.
BIFROST_API_KEY=sk-bf-...
# Bifrost model names are provider/model: openai/..., anthropic/..., gemini/...
# MODEL=openai/gpt-4.1-mini

# --- LLM without the gateway (leave BIFROST_BASE_URL empty) ------------------------------
# CrewAI then calls the provider directly; OpenAI by default.
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4.1-mini

# --- Your holdings -------------------------------------------------------------------------
# manual (default): typed in on the wallet page (`web` command), saved to WALLET_FILE.
# pluggy: read from Nubank / NuInvest through Open Finance (see below).
# WALLET_SOURCE=manual
# WALLET_FILE=wallet.json

# --- Open Finance via Pluggy (only with WALLET_SOURCE=pluggy) ----------------------------
# Create a Development Application at https://dashboard.pluggy.ai to get these credentials.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Comma-separated item ids (one per connected institution, e.g. Nubank and NuInvest).
PLUGGY_ITEM_IDS=

# --- Optional ----------------------------------------------------------------------------
# REPORTS_DIR=reports
# HTTP_TIMEOUT_SECONDS=15
# Where CVM/SEC downloads are cached (refreshed daily).
# CACHE_DIR=~/.cache/crewai_invest_reporter

# --- SEC EDGAR (official filings for BDRs) -------------------------------------------------
# SEC asks automated clients to identify themselves, e.g. "Your Name you@email.com".
# SEC_USER_AGENT=
